{
  "name": "emerging-stock-radar-derivative",
  "version": "0.1.0",
  "description": "興債觀測網｜興櫃公司、可轉債與上市櫃進度資訊",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/stage-static-showcase.mjs && node scripts/v54-data-audit.mjs",
    "build:sites": "npm run build",
    "start": "vinext start",
    "test": "npm run build && npm run test:showcase",
    "test:showcase": "node --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "snapshot:companies": "node scripts/update-company-basic-snapshot.mjs",
    "snapshot:showcase": "node scripts/refresh-static-showcase-data.mjs",
    "snapshot:ipo": "node scripts/refresh-static-ipo-snapshot.mjs",
    "snapshot:cb-market": "node scripts/build-bond-market-snapshot.mjs",
    "snapshot:cb-history": "node scripts/backfill-bond-market-history.mjs",
    "audit:v54": "node scripts/v54-data-audit.mjs",
    "audit:v55": "node scripts/v55-rights-event-qa.mjs"
  },
  "dependencies": {
    "klinecharts": "10.0.3",
    "lightweight-charts": "5.0.9",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "5.8.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
